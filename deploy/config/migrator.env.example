# shellcheck shell=sh disable=SC2034
# This file is for the explicit, owner-level one-shot command only:
#   snagline-control migrate
# It must be readable only by a dedicated migration UID, never by a control
# runtime process. The DSN contains no password; use approved external auth.
SNAGLINE_MIGRATOR_POSTGRES_DSN='postgresql://snagline_migrator@postgres.example.invalid:5432/snagline?sslmode=verify-full&sslrootcert=system'
# These are PostgreSQL NOLOGIN group roles. Login principals are provisioned
# outside Snagline and may belong to exactly one runtime group role.
SNAGLINE_AUTHORITY_CONTROL_ROLE=snagline_authority_control
SNAGLINE_AUTHORITY_DELIVERY_ROLE=snagline_authority_delivery
SNAGLINE_AUTHORITY_PROJECTOR_ROLE=snagline_authority_projector
