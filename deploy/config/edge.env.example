# shellcheck shell=sh disable=SC2034
# One file, UID, 0700 state directory, and socket directory per edge identity.
# Install this file and all private referenced files as UID snagline-edge-EDGE_ID.
SNAGLINE_EDGE_SOCKET=/run/snagline-edge-EDGE_ID/edge.sock
SNAGLINE_EDGE_OPS_SOCKET=/run/snagline-edge-EDGE_ID/ops.sock
SNAGLINE_EDGE_TENANT=REPLACE_WITH_TENANT
SNAGLINE_EDGE_ID=EDGE_ID
SNAGLINE_EDGE_GENERATION=1
SNAGLINE_EDGE_PRINCIPAL_ID=edge-principal
SNAGLINE_EDGE_AUTHOR_KEY_ID=REPLACE_WITH_EDGE_SSP_KEY_ID
SNAGLINE_EDGE_SIGNING_KEY=/run/snagline-edge-EDGE_ID/edge-signing-key.pem
SNAGLINE_EDGE_REGISTRY_ROOT_KEY=/run/snagline-edge-EDGE_ID/registry-root-public.pem
SNAGLINE_EDGE_REGISTRY_ROOT_KEY_ID=REPLACE_WITH_REGISTRY_ROOT_KEY_ID
SNAGLINE_EDGE_DB=/var/lib/snagline-edge-EDGE_ID/edge.sqlite
SNAGLINE_EDGE_DB_KEY=/run/snagline-edge-EDGE_ID/edge-sqlite.key
SNAGLINE_EDGE_CONTROL_URL=https://control.example.invalid
SNAGLINE_EDGE_TLS_CERT=/run/snagline-edge-EDGE_ID/edge-client.crt
SNAGLINE_EDGE_TLS_KEY=/run/snagline-edge-EDGE_ID/edge-client.key
SNAGLINE_EDGE_CONTROL_CA=/run/snagline-edge-EDGE_ID/control-ca.pem
SNAGLINE_EDGE_NATS_URL=tls://jetstream.example.invalid:4222
SNAGLINE_EDGE_NATS_CREDENTIALS_FILE=/run/snagline-edge-EDGE_ID/nats.creds
SNAGLINE_EDGE_NATS_CA_FILE=/run/snagline-edge-EDGE_ID/nats-ca.pem
SNAGLINE_EDGE_ENVELOPE_TTL=1h
