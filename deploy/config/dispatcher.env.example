# shellcheck shell=sh disable=SC2034
# The dispatcher is a one-shot command, not a daemon. This file supplies its
# local runtime only; each invocation supplies --case-id, --case-commitment,
# and --text. Run it as UID snagline-dispatcher with a dedicated 0700 state dir.
SNAGLINE_DISPATCHER_KEY_DESCRIPTOR=/run/snagline-dispatcher/key-descriptor.json
SNAGLINE_DISPATCHER_TENANT=REPLACE_WITH_TENANT
SNAGLINE_DISPATCHER_PRINCIPAL_ID=dispatcher-principal
SNAGLINE_DISPATCHER_AUTHOR_KEY_ID=REPLACE_WITH_DISPATCHER_SSP_KEY_ID
SNAGLINE_DISPATCHER_DB=/var/lib/snagline-dispatcher/dispatcher.sqlite
SNAGLINE_DISPATCHER_DB_KEY=/run/snagline-dispatcher/dispatcher-sqlite.key
SNAGLINE_DISPATCHER_CONTROL_URL=https://control.example.invalid
SNAGLINE_DISPATCHER_TLS_CERT=/run/snagline-dispatcher/dispatcher-client.crt
SNAGLINE_DISPATCHER_TLS_KEY=/run/snagline-dispatcher/dispatcher-client.key
SNAGLINE_DISPATCHER_CONTROL_CA=/run/snagline-dispatcher/control-ca.pem
SNAGLINE_DISPATCHER_ENVELOPE_TTL=1h
