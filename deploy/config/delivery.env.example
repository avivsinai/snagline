# shellcheck shell=sh disable=SC2034
# Install as a private environment file readable only by UID snagline-delivery.
# Credentials and CA files are separate mounts; no secret appears here.
SNAGLINE_DELIVERY_POSTGRES_DSN='postgresql://snagline_delivery_runtime@postgres.example.invalid:5432/snagline?sslmode=verify-full&sslrootcert=system'
SNAGLINE_DELIVERY_AUTHORITY_ID=REPLACE_WITH_IMMUTABLE_AUTHORITY_ID
SNAGLINE_DELIVERY_WORKER_ID=delivery-REPLACE_WITH_STABLE_INSTANCE_ID
SNAGLINE_DELIVERY_OPS_SOCKET=/run/snagline-delivery/ops.sock
SNAGLINE_DELIVERY_NATS_URL=tls://jetstream.example.invalid:4222
SNAGLINE_DELIVERY_NATS_CREDENTIALS_FILE=/run/snagline-delivery/nats.creds
SNAGLINE_DELIVERY_NATS_CA_FILE=/run/snagline-delivery/nats-ca.pem
SNAGLINE_DELIVERY_BATCH_SIZE=100
SNAGLINE_DELIVERY_LEASE=1m
SNAGLINE_DELIVERY_RETRY_DELAY=30s
SNAGLINE_DELIVERY_POLL_INTERVAL=1s
