# shellcheck shell=sh disable=SC2034
# Install as a private environment file readable only by UID snagline-control.
# The binary fails closed in production without mTLS material and an explicit
# SAN mapping. The DSN contains no password; use approved external auth.
SNAGLINE_CONTROL_ENVIRONMENT=production
SNAGLINE_CONTROL_LISTEN=:8443
SNAGLINE_CONTROL_OPS_SOCKET=/run/snagline-control/ops.sock
SNAGLINE_CONTROL_POSTGRES_DSN='postgresql://snagline_control_runtime@postgres.example.invalid:5432/snagline?sslmode=verify-full&sslrootcert=system'
SNAGLINE_CONTROL_TENANT=REPLACE_WITH_TENANT
SNAGLINE_CONTROL_AUTHORITY_ID=REPLACE_WITH_IMMUTABLE_AUTHORITY_ID
SNAGLINE_CONTROL_REGISTRY_ROOT_KEY=/run/snagline-control/registry-root-public.pem
SNAGLINE_CONTROL_REGISTRY_ROOT_KEY_ID=REPLACE_WITH_REGISTRY_ROOT_KEY_ID
SNAGLINE_CONTROL_REGISTRY_PUBLISHER_PRINCIPAL=REPLACE_WITH_REGISTRY_PUBLISHER_PRINCIPAL
SNAGLINE_CONTROL_TLS_CERT=/run/snagline-control/control-server.crt
SNAGLINE_CONTROL_TLS_KEY=/run/snagline-control/control-server.key
SNAGLINE_CONTROL_CLIENT_CA=/run/snagline-control/client-ca.pem
# Comma-separated. Each value is SAN=principal or SAN=principal|edge_id|generation.
# The SAN must exactly match the presented client certificate.
SNAGLINE_CONTROL_CLIENT_SAN_WORKLOAD='dns:edge-EDGE_ID.example.invalid=edge-principal|EDGE_ID|1,dns:dispatcher.example.invalid=dispatcher-principal,dns:registry-publisher.example.invalid=registry-publisher-principal'
