    {"family": "case-v1", "path": ["expires_at"], "role": "envelope.expires_at"},
    {"family": "advice-v1", "path": ["emitted_at"], "role": "envelope.emitted_at"},
    {"family": "advice-v1", "path": ["expires_at"], "role": "envelope.expires_at"},
