{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snagline.dev/ssp/case-v1.schema.json",
  "title": "SSP Case v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "case_id", "emitted_at", "expires_at", "routing_epoch", "registry_revision", "registry_hash", "author_key_id", "signature_alg", "body", "signature"],
  "properties": {
    "schema": {"const": "ssp.case.v1"},
    "id": {"$ref": "#/$defs/opaqueID"},
    "case_id": {"$ref": "#/$defs/opaqueID"},
    "emitted_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "not": {"pattern": "[\\r\\n]"}},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "not": {"pattern": "[\\r\\n]"}},
    "routing_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "registry_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "registry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "author_key_id": {"$ref": "#/$defs/opaqueID"},
    "signature_alg": {"const": "ed25519"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$", "minLength": 86, "maxLength": 86, "not": {"pattern": "[\\r\\n]"}},
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "issuer_edge_id", "issuer_edge_generation", "summary", "public_summary", "context_manifest"],
      "properties": {
        "domain": {"$ref": "#/$defs/opaqueID"},
        "issuer_edge_id": {"$ref": "#/$defs/opaqueID"},
        "issuer_edge_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "public_summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "context_manifest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}
      }
    }
  },
  "$defs": {"opaqueID": {"type": "string", "minLength": 1, "maxLength": 512}}
}
